---
/**
 * ContactFooter: compact conversion CTA plus a simple sitemap footer
 * containing only links that exist on this one-pager.
 */
const navigate = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/#services' },
  { label: 'Contact', href: '/#contact' },
];
---

<section class="contact" id="contact" aria-label="Get a quote">
  <div class="container contact__inner">
    <div class="contact__copy reveal">
      <p class="eyebrow">03 / Contact</p>
      <h2 class="contact__title">Ready to move fuel without delays?</h2>
      <p class="contact__sub">
        Tell us your volume, route and timeline. We&rsquo;ll respond with a
        firm quote.
      </p>
    </div>
    <div class="contact__actions reveal" style="--reveal-delay: 0.12s">
      <a href="#contact" class="btn-gold" data-quote>
        Get a Quote
        <svg viewBox="0 0 22 12" fill="none" aria-hidden="true">
          <path d="M0 6h20M15 1.5 19.5 6 15 10.5" stroke="currentColor" stroke-width="1.6" />
        </svg>
      </a>
      <a class="contact__mail" href="mailto:info@lgpetroleum.africa">
        info@lgpetroleum.africa
      </a>
      <div class="contact__lines">
        <a class="contact__mail" href="tel:+233530531001" aria-label="Call +233 53 053 1001">
          +233 53 053 1001
        </a>
        <a
          class="contact__mail"
          href="https://wa.me/233530531001"
          target="_blank"
          rel="noopener"
          aria-label="Chat on WhatsApp with +233 53 053 1001"
        >
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<footer class="site-footer" aria-label="Footer">
  <div class="container site-footer__grid">
    <div class="site-footer__intro reveal">
      <p class="site-footer__headline">Moving fuel, depot to door.</p>
      <p class="site-footer__about">
        Liberty Global Petroleum is an independent petroleum logistics
        company delivering safe, efficient and reliable supply solutions
        across Ghana and West Africa.
      </p>
    </div>

    <nav class="site-footer__col reveal" aria-label="Navigate" style="--reveal-delay: 0.08s">
      <h3>Navigate</h3>
      <ul>
        {navigate.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__col reveal" style="--reveal-delay: 0.14s">
      <h3>Head Office</h3>
      <address>
        <p>Liberty Global Petroleum</p>
        <p>Accra, Ghana</p>
        <p>
          <a href="mailto:info@lgpetroleum.africa">info@lgpetroleum.africa</a>
        </p>
        <p>
          <a href="tel:+233530531001" aria-label="Call +233 53 053 1001">+233 53 053 1001</a>
        </p>
        <p>
          <a
            href="https://wa.me/233530531001"
            target="_blank"
            rel="noopener"
            aria-label="Chat on WhatsApp with +233 53 053 1001"
          >WhatsApp</a>
        </p>
      </address>
      <a href="#contact" class="site-footer__quote" data-quote>Get a Quote</a>
    </div>
  </div>

  <p class="container site-footer__credits">
    Photo credits: W.carter, Carl Young and Grendelkhan
    (<a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener">CC BY-SA 4.0</a>),
    Frans Berkelaar
    (<a href="https://creativecommons.org/licenses/by/2.0/" rel="noopener">CC BY 2.0</a>),
    via <a href="https://commons.wikimedia.org/" rel="noopener">Wikimedia Commons</a>.
  </p>

  <div class="container site-footer__base">
    <p>© <span data-year>2026</span> Liberty Global Petroleum</p>
    <a href="#top" class="to-top" aria-label="Back to top">
      <svg viewBox="0 0 12 14" fill="none" aria-hidden="true">
        <path d="M6 13V1M1.5 5.5 6 1l4.5 4.5" stroke="currentColor" stroke-width="1.6" />
      </svg>
    </a>
  </div>
</footer>

<style>
  .contact {
    background: var(--bg-deep);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: clamp(3.5rem, 8vw, 5.5rem) 0;
  }

  .contact__inner {
    display: grid;
    gap: 2rem;
  }

  .contact__copy .eyebrow {
    display: block;
    margin-bottom: 1rem;
  }

  .contact__title {
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.025rem;
    line-height: 1.12;
    text-wrap: balance;
  }

  .contact__sub {
    margin-top: 0.9rem;
    color: var(--muted);
    max-width: 48ch;
  }

  .contact__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .contact__lines {
    display: flex;
    flex-direction: column;
    align-items: inherit;
    gap: 0.8rem;
  }

  .contact__mail {
    color: var(--muted);
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .contact__mail:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  .site-footer {
    background: #060607;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: clamp(3.5rem, 8vw, 6rem) 0 0;
  }

  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .site-footer__headline {
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    font-weight: 300;
    letter-spacing: -0.025rem;
    line-height: 1.12;
    text-wrap: balance;
    max-width: 14ch;
  }

  .site-footer__about {
    margin-top: 1.4rem;
    color: var(--faint);
    font-size: 0.94rem;
    line-height: 1.75;
    max-width: 42ch;
  }

  .site-footer__col h3 {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: -0.025rem;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 1.4rem;
  }

  .site-footer__col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .site-footer__col address {
    font-style: normal;
  }

  .site-footer__col address p {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .site-footer__col a {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.94rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-footer__col a:hover {
    color: var(--gold);
  }

  .site-footer__quote {
    display: inline-block;
    margin-top: 1.2rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.025rem;
    text-transform: uppercase;
    color: var(--gold) !important;
    border-bottom: 1px solid rgba(239, 191, 4, 0.4);
    padding-bottom: 3px;
    transition: border-color 0.2s ease;
  }

  .site-footer__quote:hover {
    border-color: var(--gold);
  }

  .site-footer__credits {
    padding-bottom: 1.25rem;
    font-size: 0.75rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.38);
  }

  .site-footer__credits a {
    color: inherit;
    text-underline-offset: 2px;
  }

  .site-footer__base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-block: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.72rem;
    letter-spacing: -0.025rem;
    text-transform: uppercase;
    color: var(--faint);
  }

  .site-footer__base a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.25s ease,
      transform 0.25s var(--ease-out);
  }

  .site-footer__base a:hover {
    color: var(--gold);
  }

  .to-top {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
  }

  .to-top svg {
    width: 13px;
    height: 15px;
  }

  .to-top:hover {
    border-color: var(--gold);
    transform: translateY(-3px);
  }

  @media (min-width: 720px) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 0.7fr 1fr;
      gap: clamp(2rem, 5vw, 5rem);
    }
  }

  @media (min-width: 900px) {
    .contact__inner {
      grid-template-columns: 1.3fr 1fr;
      align-items: center;
    }

    .contact__actions {
      align-items: flex-end;
      text-align: right;
    }

  }
</style>
