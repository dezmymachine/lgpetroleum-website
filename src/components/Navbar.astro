---
/**
 * Navbar: transparent overlay on hero, blur after scroll.
 * Desktop: logo left · Home / About / Contact + Get a Quote right.
 * Mobile: logo left · animated hamburger right, panel slides in from right.
 */
---

<header class="nav" id="siteNav" data-nav>
  <div class="nav__inner container">
    <a href="#home" class="nav__brand" aria-label="Liberty Global Petroleum homepage">
      <img
        src="/logo.png"
        alt="Liberty Global Petroleum logo"
        width="1184"
        height="500"
        fetchpriority="high"
      />
    </a>

    <nav class="nav__links" aria-label="Primary">
      <a href="#home" class="nav__link is-active">Home</a>
      <a href="#about" class="nav__link">About</a>
      <a href="#services" class="nav__link">Services</a>
      <a href="#contact" class="nav__link">Contact</a>
      <a href="#contact" class="btn-outline nav__quote" data-quote>Get a Quote</a>
    </nav>

    <button
      class="nav__toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
      data-menu-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="nav__backdrop" data-menu-backdrop hidden></div>

<aside
  class="nav__mobile"
  id="mobileMenu"
  aria-label="Mobile navigation"
  data-menu-panel
  inert
>
  <nav class="nav__mobile-links">
    <a href="#home" class="nav__mobile-link" style="--i: 0">Home</a>
    <a href="#about" class="nav__mobile-link" style="--i: 1">About</a>
    <a href="#services" class="nav__mobile-link" style="--i: 2">Services</a>
    <a href="#contact" class="nav__mobile-link" style="--i: 3">Contact</a>
    <a
      href="#contact"
      class="btn-gold nav__mobile-quote"
      style="--i: 4"
      data-quote
    >
      Get a Quote
    </a>
  </nav>
  <p class="nav__mobile-foot">Head Office · Accra</p>
</aside>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    background: transparent;
    transition: background 0.3s ease, box-shadow 0.3s ease,
      backdrop-filter 0.3s ease;
  }

  .nav.is-scrolled {
    background: rgba(15, 15, 15, 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav__brand img {
    height: 52px;
    width: auto;
  }

  @media (max-width: 859px) {
    .nav__brand img {
      height: 44px;
    }
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: 2.2rem;
  }

  .nav__link {
    position: relative;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    padding-block: 0.35rem;
    transition: color 0.2s ease;
  }

  .nav__link:hover {
    color: #fff;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 100%;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }

  .nav__link:hover::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  .nav__quote {
    margin-left: 0.6rem;
  }

  /* Hamburger */
  .nav__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    align-items: flex-end;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 10px 4px 10px 14px;
  }

  .nav__toggle span {
    display: block;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.35s var(--ease-out), width 0.35s var(--ease-out),
      opacity 0.25s ease;
  }

  .nav__toggle span:nth-child(1) { width: 26px; }
  .nav__toggle span:nth-child(2) { width: 26px; }
  .nav__toggle span:nth-child(3) { width: 18px; }

  .nav__toggle:hover span { background: var(--gold); }

  body.menu-open .nav__toggle span:nth-child(1) {
    width: 26px;
    transform: translateY(8px) rotate(45deg);
  }

  body.menu-open .nav__toggle span:nth-child(2) {
    opacity: 0;
    transform: translateX(10px);
  }

  body.menu-open .nav__toggle span:nth-child(3) {
    width: 26px;
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Backdrop */
  .nav__backdrop {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(0, 0, 0, 0.55);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  body.menu-open .nav__backdrop {
    opacity: 1;
  }

  /* Mobile panel: smooth enter from the right */
  .nav__mobile {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 95;
    height: 100dvh;
    width: min(340px, 84vw);
    background: #101010;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    padding: calc(var(--nav-h) + 1rem) 2.2rem 2.2rem;
    transform: translateX(102%);
    transition: transform 0.45s var(--ease-out);
    visibility: hidden;
  }

  body.menu-open .nav__mobile {
    transform: translateX(0);
    visibility: visible;
  }

  .nav__mobile-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .nav__mobile-link {
    color: var(--fg);
    font-size: clamp(1.7rem, 7vw, 2.1rem);
    font-weight: 300;
    letter-spacing: -0.01em;
    text-decoration: none;
    padding-block: 0.5rem;
    opacity: 0;
    transform: translateX(44px);
    transition: opacity 0.4s ease, transform 0.5s var(--ease-out),
      color 0.2s ease;
    transition-delay: calc(0.08s * var(--i) + 0.12s);
  }

  .nav__mobile-link:hover {
    color: var(--gold);
  }

  body.menu-open .nav__mobile-link,
  body.menu-open .nav__mobile-quote {
    opacity: 1;
    transform: translateX(0);
  }

  .nav__mobile-quote {
    margin-top: 1.2rem;
    justify-content: center;
    opacity: 0;
    transform: translateX(44px);
    transition: opacity 0.4s ease, transform 0.5s var(--ease-out),
      background 0.25s ease;
    transition-delay: calc(0.08s * var(--i) + 0.12s);
  }

  .nav__mobile-foot {
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--faint);
  }

  @media (min-width: 860px) {
    .nav__links {
      display: inline-flex;
    }

    .nav__toggle,
    .nav__mobile,
    .nav__backdrop {
      display: none;
    }
  }

  @media (max-width: 859px) {
    :root {
      --nav-h: 64px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__mobile,
    .nav__mobile-link,
    .nav__mobile-quote {
      transition: none;
      transform: none;
      opacity: 1;
    }
  }
</style>
