---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import MiniAbout from '../components/MiniAbout.astro';
import Services from '../components/Services.astro';
import ContactFooter from '../components/ContactFooter.astro';
import QuoteModal from '../components/QuoteModal.astro';
import SiteScripts from '../components/SiteScripts.astro';

const title = 'Liberty Global Petroleum | Petroleum Logistics, Storage & Transport in Ghana';
const description =
  'Liberty Global Petroleum delivers end-to-end petroleum logistics in Ghana and West Africa. Safe storage, efficient transport and dependable fuel supply. Get a quote today.';
---

<BaseLayout title={title} description={description}>
  <Navbar />
  <main id="main">
    <Hero />
    <MiniAbout />
    <Services />
  </main>
  <ContactFooter />
  <QuoteModal />

  <SiteScripts />
</BaseLayout>
