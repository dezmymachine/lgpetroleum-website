<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>LG Petroleum — Coming Soon</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wdth,wght@75..125,100..700&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --font: 'Google Sans Flex', 'Google Sans', sans-serif;
        --bg: #000;
        --fg: #fff;
        --accent: #e8e8e8;
        --footer-fg: #555;
      }

      html, body {
        height: 100%;
        overflow: hidden;
      }

      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100dvh;
      }

      main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        width: 100%;
        overflow: hidden;
      }

      .typewriter-wrap {
        text-align: center;
      }

      .typewriter {
        font-size: clamp(1.8rem, 6vw, 7rem);
        font-weight: 600;
        font-variation-settings: 'wght' 600, 'wdth' 100;
        letter-spacing: -0.02em;
        white-space: nowrap;
        overflow: hidden;
        border-right: 3px solid var(--fg);
        width: 0;
        animation:
          typing 2.2s steps(12, end) 0.5s forwards,
          blink 0.75s step-end infinite;
      }

      @keyframes typing {
        from { width: 0 }
        to   { width: 13ch }
      }

      @keyframes blink {
        0%, 100% { border-color: var(--fg) }
        50%       { border-color: transparent }
      }

      footer {
        width: 100%;
        padding: 1.5rem 2rem;
        text-align: center;
        font-size: 0.85rem;
        font-weight: 400;
        color: var(--footer-fg);
        letter-spacing: 0.02em;
      }

      footer a {
        color: inherit;
        text-decoration: none;
        transition: color 0.2s;
      }

      footer a:hover {
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <main>
      <div class="typewriter-wrap">
        <p class="typewriter">Coming Soon</p>
      </div>
    </main>

    <footer>
      <a href="mailto:info@lgpetroleum.africa">info@lgpetroleum.africa</a>
    </footer>
  </body>
</html>
